# Default provider: qwen | deepseek | generic | stub
REVIEW_PROVIDER=qwen
REVIEW_MODEL=qwen3.8-flash

# Qwen AI Platform (OpenAI-compatible API)
DASHSCOPE_API_KEY=
# Optional alias accepted by the engine
QWENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Generic OpenAI-compatible provider
REVIEW_BASE_URL=
REVIEW_API_KEY=

# Runtime behavior
REVIEW_TIMEOUT_SECONDS=120
REVIEW_MAX_RETRIES=3
REVIEW_JSON_MODE=1
REVIEW_MAX_TOKENS=8000

# Only for UI/contract previews. Never use for accepted review results.
REVIEW_ALLOW_STUB=0

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
