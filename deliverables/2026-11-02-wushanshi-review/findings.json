[
  {
    "finding_id": "finding-6c7350fda27a4cc686bd2fe586d8c32b",
    "kind": "issue",
    "title": "全选或部分选中后，数量仍为0000000且分解可得固定不变",
    "check_ids": [
      "check-59435abf39eca228"
    ],
    "evidence_ids": [
      "ev-180be5d0038841f1a1923c911f7a34ac",
      "ev-267e7882131347248659640d254e4245",
      "ev-d5bd69dd3dce4634908ff540752bde28"
    ],
    "principle": "全选、部分选择应实时驱动数量与分解可得汇总，使提交前可核对；数量为零时应阻止提交或明确禁用。",
    "detection": "ev-180be5d0038841f1a1923c911f7a34ac 中所有等级与物品已呈绿色勾选、底栏“全选”也勾选，但右侧“数量”仍为0000000，“分解可得/拥有”固定为123456789；ev-267e7882131347248659640d254e4245 仅部分等级勾选时同样显示数量0000000。",
    "description": "设计稿未呈现“全选→数量→分解可得”的联动，且全选后数量为零与已选范围矛盾。玩家无法在按下分解前确认将消耗多少材料，可能空分解或误分解高级吴山石；静态设计只能说明状态不自洽，不能证明运行时计算错误。",
    "suggestion": "由勾选物品实时汇总数量，分解可得随数量刷新；数量为0时禁用“分解”并就近提示至少选择1个吴山石，全选与等级勾选共用同一状态源。",
    "severity": "high",
    "severity_reason": "批量分解前的数量核对失效，可能误分解高等级绑定吴山石；错误提交后难以恢复。",
