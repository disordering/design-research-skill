+def quarantine_unverifiable_claims(result, evidence):
+    """Temporary copy: keep strict quotes; quarantine unsupported claims, never invent OCR."""
+    warnings = []
+    removed = set()
+    for field in ('goals', 'requirements', 'opinions'):
+        kept = []
+        for claim in getattr(result, field):
+            quotes = claim.source_quotes
+            bad_quote = any(q.evidence_id not in evidence or not quote_matches(evidence[q.evidence_id], q.quote) for q in quotes)
+            missing = field != 'opinions' and not claim.is_assumption and (
+                not quotes or set(claim.evidence_ids) != {q.evidence_id for q in quotes})
+            if bad_quote or missing:
+                removed.add(claim.id)
+                note = f'待核实声明 {claim.id}：{claim.text[:350]}（缺少可逐字验证的完整来源引用，未作为正式评审依据。）'
+                result.unknowns.append(note)
+                warnings.append(f'副本引用隔离：{claim.id} 已移至待核实项；未放宽逐字引用校验。')
+            else:
+                kept.append(claim)
+        setattr(result, field, kept)
+    # A child cannot outlive an unsupported parent.
+    while True:
+        descendants = [c for c in [*result.goals, *result.requirements] if c.parent_id in removed]
+        if not descendants:
+            break
+        for claim in descendants:
+            removed.add(claim.id)
+            result.unknowns.append(f'待核实声明 {claim.id}：{claim.text[:350]}（父声明未通过来源校验。）')
+        result.goals = [c for c in result.goals if c.id not in removed]
+        result.requirements = [c for c in result.requirements if c.id not in removed]
+    result.conflicts = [c for c in result.conflicts if not set(c.claim_ids).intersection(removed) and all(
+        q.evidence_id in evidence and quote_matches(evidence[q.evidence_id], q.quote) for q in c.source_quotes)]
+    return warnings
