--- original/tests/test_temporary_quote_quarantine.py
+++ temporary-copy/tests/test_temporary_quote_quarantine.py
@@ -0,0 +1,44 @@
+from engine.session_contracts import MaterialUnderstanding, Constraint, EvidenceQuote
+from engine.session_context import quarantine_unverifiable_claims, validate_quotes
+from types import SimpleNamespace
+import pytest
+
+def test_unsupported_image_quote_is_quarantined_not_accepted():
+    evidence={'image':SimpleNamespace(content='静态图片，不证明点击行为。')}
+    bad=EvidenceQuote(evidence_id='image',quote='点击分解获得积分')
+    with pytest.raises(Exception): validate_quotes([bad],evidence)
+    result=MaterialUnderstanding(task_summary='Review', requirements=[Constraint(id='REQ1',text='点击分解获得积分',evidence_ids=['image'],source_quotes=[bad])])
+    assert quarantine_unverifiable_claims(result,evidence)
+    assert not result.requirements
+    assert 'REQ1' in result.unknowns[0]
+    with pytest.raises(Exception): validate_quotes([bad],evidence)
+
+def test_supported_claim_survives_and_orphaned_child_is_quarantined():
+    evidence={'text':SimpleNamespace(content='取消不得保存。')}
+    good=Constraint(id='G1',text='取消不得保存',evidence_ids=['text'],source_quotes=[EvidenceQuote(evidence_id='text',quote='取消不得保存。')])
+    missing=Constraint(id='REQ1',text='Unsupported',evidence_ids=['text'])
+    child=Constraint(id='REQ2',text='Child',evidence_ids=['text'],is_assumption=True,parent_id='REQ1')
+    result=MaterialUnderstanding(task_summary='Review',goals=[good],requirements=[missing,child])
+    quarantine_unverifiable_claims(result,evidence)
+    assert result.goals==[good]
+    assert not result.requirements
+    assert len(result.unknowns)==2
+
+
+def test_conflict_evidence_downgrade_uses_needs_clarification(tmp_path):
+    import asyncio
+    from tests.test_session_service import create_service, FixtureModel
+    from engine.session_contracts import SessionCreate, SourceInput
+    service, _ = create_service(tmp_path)
+    session = service.create(SessionCreate(purpose='Conflict enum regression',sources=[SourceInput(kind='document',content='Unconfirmed constraints',role='product_spec')]))
+    async def run():
+        await service._read_sources(session)
+        for check in session.checks:
+            check.scope_status = 'included' if check.ref == 'E08' else 'excluded'
+            if check.ref == 'E08':
+                check.applicability='needs_context'
+        await service._judge(session,FixtureModel())
+    asyncio.run(run())
+    check=next(c for c in session.checks if c.ref=='E08')
+    assert check.execution_status=='executed'
+    assert check.decision=='needs_clarification'
