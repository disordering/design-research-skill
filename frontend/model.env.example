# Copy to repository root .env; replace values locally. Never commit a real key.
REVIEW_PROVIDER=generic
REVIEW_BASE_URL=https://your-compatible-service.example/v1
REVIEW_MODEL=your-vision-model-name
REVIEW_API_KEY=
REVIEW_TIMEOUT_SECONDS=90
REVIEW_MAX_RETRIES=1
# Optional: set only if your own computer requires this proxy. Do not copy another person's port.
# HTTPS_PROXY=http://127.0.0.1:YOUR_PORT
# HTTP_PROXY=http://127.0.0.1:YOUR_PORT
NO_PROXY=127.0.0.1,localhost,::1
